# --- EnergyPlus ---
ENERGYPLUS_DIR=/usr/local/EnergyPlus-24-1-0
IDF_PATH=models/baseline.idf
EPW_PATH=models/weather/site.epw
OUTPUT_DIR=logs/eplus_out

# --- LLM (Ollama-compatible; also works with vLLM/LM Studio OpenAI-compatible servers) ---
LLM_BASE_URL=http://localhost:11434/api/chat
LLM_MODEL=llama3.1
LLM_TIMEOUT_SECONDS=20

# --- Control loop timing ---
AGENT_DECISION_INTERVAL_TIMESTEPS=6   # call the LLM every N zone timesteps
COMFORT_TEMP_MIN_C=21.0
COMFORT_TEMP_MAX_C=25.0
PEAK_DEMAND_THRESHOLD_KW=50.0
